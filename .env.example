# Copy to .env (local) or add as environment variables in your hosting dashboard.
# None of these values are secrets: they are embedded in public HTML/JS.

# Public origin of the site, without a trailing slash. Used for canonical URLs,
# Open Graph URLs, sitemap.xml and robots.txt. Example: https://imagecolorreplace.com
VITE_SITE_URL=

# Public contact address shown on the Contact page.
VITE_CONTACT_EMAIL=

# Google Search Console "HTML tag" verification: only the content value of the
# <meta name="google-site-verification" content="..."> tag Google gives you.
VITE_GOOGLE_SITE_VERIFICATION=

# Google AdSense (leave empty to keep ads completely disabled).
# Publisher ID looks like ca-pub-1234567890123456. Ad unit (slot) IDs are 10 digits.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_ARTICLE=
