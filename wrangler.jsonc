// Cloudflare Workers deployment: serves the prerendered static site in ./dist.
// No Worker script is needed; everything is static assets.
{
  "name": "image-color-replace",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // /faq is served from faq.html; unknown URLs get 404.html with status 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
